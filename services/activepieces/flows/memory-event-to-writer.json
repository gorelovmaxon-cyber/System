{
  "schema": "system2.activepieces.flow-blueprint.v1",
  "name": "System2 memory event to writer",
  "status": "awaiting-import-validation",
  "transport": "webhook",
  "trigger": {
    "type": "webhook",
    "method": "POST",
    "path": "<WEBHOOK_ID>/sync",
    "input": "SC-07 event schema v1"
  },
  "steps": [
    {
      "id": "prepare_prompt",
      "type": "data-mapper",
      "input": ["event_id", "project_id", "kind", "summary", "decisions", "user_corrections", "checks", "next_action", "diff"],
      "limits": {"diff_max_bytes": 20000}
    },
    {
      "id": "analyze",
      "type": "ai",
      "connection": "<ACTIVEPIECES_AI_CONNECTION_NAME>",
      "model": "<ACTIVEPIECES_AI_MODEL>",
      "prompt": "Analyze the event for durable knowledge. Return JSON only with has_pattern boolean and proposals array. Do not invent facts. Ignore one-off details and generated files. Each proposal must contain category, statement, evidence, scope, status, and optional confidence/supersedes.",
      "response_schema": {
        "has_pattern": "boolean",
        "proposals": "array"
      }
    },
    {
      "id": "validate",
      "type": "code-or-schema-validation",
      "rules": [
        "AI response is valid JSON",
        "has_pattern is boolean",
        "category is one of user-profile, facts, patterns, decisions, gotchas",
        "statement and evidence are non-empty",
        "status is one of observation, confirmed, superseded",
        "scope is user or a registered project_id"
      ]
    },
    {
      "id": "no_pattern",
      "type": "condition",
      "when": "has_pattern == false",
      "on_true": "success_without_write"
    },
    {
      "id": "write",
      "type": "http-request",
      "method": "POST",
      "url": "<AP_HOST_BRIDGE_URL>/write",
      "headers": {"Authorization": "Bearer <MEMORY_BRIDGE_TOKEN>"},
      "body": {"event_id": "{{trigger.body.event_id}}", "proposals": "{{validate.proposals}}"},
      "success": "HTTP 200 persisted",
      "retryable_errors": [429, 500, 502, 503, 504]
    },
    {
      "id": "confirm",
      "type": "condition",
      "when": "write.status == persisted",
      "on_true": "success",
      "on_false": "visible_error_and_retry"
    },
    {
      "id": "return_response",
      "type": "webhook-return-response",
      "on_persisted": {"status": 200, "body": {"event_id": "{{trigger.body.event_id}}", "status": "persisted"}},
      "on_no_pattern": {"status": 200, "body": {"event_id": "{{trigger.body.event_id}}", "status": "no-pattern"}},
      "on_error": {"status": 500, "body": {"event_id": "{{trigger.body.event_id}}", "status": "failed"}}
    }
  ],
  "secrets": {
    "ai_connection": "configured in Activepieces UI",
    "memory_bridge_token": "configured as local Activepieces secret",
    "webhook_id": "generated by Activepieces"
  }
}
