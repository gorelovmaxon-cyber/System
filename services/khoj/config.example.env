# Пример локальной конфигурации Khoj 1.42.10 для System2.
#
# Скопируйте в services/khoj/config.local.env (gitignored) и подставьте свои
# значения. Файл читает services/khoj/run-local.py: отдельного YAML-конфига у
# релиза нет, настройка идёт переменными окружения и аргументами CLI.
#
# Запуск:    <venv>/Scripts/python.exe services/khoj/run-local.py
# Источник:  ... run-local.py --set-memory-source
# Состояние: ... run-local.py --status
# Остановка: ... run-local.py --stop

# Встроенный PostgreSQL. Khoj читает USE_EMBEDDED_DB, но его собственная ветка
# embedded-DB рассчитана на Unix-сокеты и на Windows нерабочая; фактический
# сервер и его адрес поднимает run-local.py, здесь задаётся только каталог данных.
USE_EMBEDDED_DB=true
PGSERVER_DATA_DIR=<ABSOLUTE_PATH_TO_PGSERVER_DATA>

# Секреты генерируются локально и не попадают в Git, отчёты и индекс:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
KHOJ_DJANGO_SECRET_KEY=<GENERATE_LOCALLY>
KHOJ_ADMIN_EMAIL=<LOCAL_ADMIN_EMAIL>
KHOJ_ADMIN_PASSWORD=<GENERATE_LOCALLY>

# Локальный сервис без HTTPS и без телеметрии.
KHOJ_NO_HTTPS=true
KHOJ_TELEMETRY_DISABLE=true
KHOJ_HOST=127.0.0.1
KHOJ_PORT=42110

# Единственный источник индекса: каноническая память проекта, только Markdown.
# Путь должен указывать на .claude/memory — не на репозиторий, services/ или runtime/.
KHOJ_MEMORY_ROOT=<SYSTEM_ROOT>/.claude/memory
