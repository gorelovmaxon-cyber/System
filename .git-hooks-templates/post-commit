#!/usr/bin/env bash
# System2 portable post-commit hook: capture only; never push.
set +e
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0
SYSTEM_ROOT_NATIVE="${SYSTEM2_ROOT:-$ROOT}"
if command -v cygpath >/dev/null 2>&1; then
  SYSTEM_ROOT_SHELL="$(cygpath -u "$SYSTEM_ROOT_NATIVE")"
  SYSTEM_ROOT_NATIVE="$(cygpath -w "$SYSTEM_ROOT_SHELL")"
else
  SYSTEM_ROOT_SHELL="${SYSTEM_ROOT_NATIVE//\\//}"
fi
SCRIPT_ROOT="$SYSTEM_ROOT_SHELL/scripts/memory"
[ -f "$SCRIPT_ROOT/capture.js" ] || exit 0
MESSAGE="$(git log -1 --pretty=%B 2>/dev/null)"
case "$MESSAGE" in
  auto-learn:*|system2-index:*) exit 0 ;;
esac
SHA="$(git rev-parse HEAD 2>/dev/null)" || exit 0
PROJECT_ID="${SYSTEM2_PROJECT_ID:-$(SYSTEM2_ROOT="$SYSTEM_ROOT_NATIVE" node "$SCRIPT_ROOT/project-id.js" "$ROOT" 2>/dev/null)}"
[ -n "$PROJECT_ID" ] || exit 0
node -e "require('node:fs').mkdirSync('.local/hook',{recursive:true})" || exit 0
DIFF_FILE=".local/hook/diff-${SHA}.txt"
# База сравнения — первый родитель, которого у первого commit в истории нет:
# жёсткий HEAD^ падал, ошибка подавлялась, и commit сохранялся без содержимого
# (G19). Для merge-commit берётся первый родитель — это оговорённая политика, а
# не «изменений нет». Родитель запрашивается у Git: разбор строки rev-list
# ломался на root-commit (cut без разделителя возвращал сам sha, и diff шёл
# между HEAD и HEAD).
PARENT="$(git rev-parse --verify --quiet HEAD^1 2>/dev/null)"
if [ -n "$PARENT" ]; then
  BASE="$PARENT"
else
  BASE="$(git hash-object -t tree /dev/null 2>/dev/null)"
fi
if [ -n "$BASE" ]; then
  git diff --no-ext-diff "$BASE" HEAD > "$DIFF_FILE" 2>/dev/null || DIFF_OK=0
else
  DIFF_OK=0
fi
# Ошибка получения diff не выдаётся за корректный пустой diff; пустой diff
# пустого commit остаётся допустимым и остаётся пустым.
if [ "${DIFF_OK:-1}" != 1 ]; then
  printf '%s\n' "[system2: diff for $SHA could not be computed against ${BASE:-unknown base}]" > "$DIFF_FILE"
fi
SYSTEM2_ROOT="$SYSTEM_ROOT_NATIVE" node "$SCRIPT_ROOT/capture.js" commit --project "$PROJECT_ID" --sha "$SHA" --message "$MESSAGE" --diff "$DIFF_FILE" --enqueue-only >> .local/hook/capture.log 2>&1 || exit 0
node -e "try{require('node:fs').unlinkSync(process.argv[1])}catch{}" "$DIFF_FILE"
# Повторная доставка после перезапуска сервиса без нового commit: worker
# догоняет backoff очереди в пределах ограниченного окна и завершается сам.
# Более длительные простои закрывает явный `queue-worker.js --watch` (см.
# docs/system-operations.md), а не бессрочный фоновый процесс из hook.
(SYSTEM2_ROOT="$SYSTEM_ROOT_NATIVE" node "$SCRIPT_ROOT/queue-worker.js" --watch --no-revive --max-idle-ms 120000 >> .local/hook/capture.log 2>&1) &
exit 0
