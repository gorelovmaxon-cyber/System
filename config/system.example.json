{
  "schema_version": "1",
  "system_name": "System2",
  "memory_root": ".claude/memory",
  "data_dir": ".local",
  "registry": [
    {
      "project_id": "systemqwen",
      "title": "SystemQwen (система разработки)",
      "kind": "meta"
    },
    {
      "project_id": "site-portfolio",
      "title": "C-portfolio",
      "kind": "client-site"
    },
    {
      "project_id": "trading-dev",
      "title": "Binance Trading System",
      "kind": "dev"
    },
    {
      "project_id": "autopilot-framework",
      "title": "Autopilot Framework",
      "kind": "dev"
    }
  ],
  "memory_categories": [
    "user-profile",
    "facts",
    "patterns",
    "decisions",
    "gotchas"
  ],
  "search": {
    "result_limit": 3,
    "budget_tokens_per_item": 1200,
    "timeout_ms": 1500,
    "local_fallback": true
  },
  "integrations": {
    "khoj": {
      "base_url": "http://127.0.0.1:42110",
      "enabled": false
    },
    "bridge": {
      "base_url": "http://127.0.0.1:8643",
      "enabled": false
    },
    "activepieces": {
      "webhook_url_placeholder": "http://<host>:8642/api/v1/webhooks/<WEBHOOK_ID>",
      "compose_file": "services/activepieces/docker-compose.yml"
    }
  },
  "events": {
    "max_diff_bytes": 20000
  },
  "queue": {
    "retries_max": 5,
    "backoff_ms": 1000
  },
  "delivery": {
    "endpoint": "http://<host>:8642/api/v1/webhooks/<WEBHOOK_ID>"
  },
  "bridge": {
    "port": 8643,
    "token": "<GENERATE_LOCALLY>"
  },
  "writer": {
    "categories": ["user-profile", "facts", "patterns", "decisions", "gotchas"]
  }
}
